{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minava.bg/schema/protocol-1.json",
  "title": "Minava clinical protocol",
  "description": "Structure of a clinical protocol file. Mechanical bounds only: this schema constrains what the engine can execute, never what is clinically correct. See docs/ДИШАНЕ.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kind", "status", "approval", "title"],
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema the file was written against.",
      "type": "integer",
      "const": 1
    },
    "id": {
      "description": "Stable identifier. Never reused for different content.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$"
    },
    "version": {
      "description": "Incremented on every content change. Approval applies to one version only.",
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": ["breathing", "grounding", "exposure", "screening", "crisis-path"]
    },
    "status": {
      "description": "draft and review never ship. Only approved is executable in a release build.",
      "type": "string",
      "enum": ["draft", "review", "approved"]
    },
    "approval": {
      "description": "Null until a qualified professional has signed off in writing on this exact version.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvedBy", "approvedAt", "appliesToVersion", "scope"],
          "properties": {
            "approvedBy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "credentials"],
              "properties": {
                "name": { "type": "string", "minLength": 2 },
                "credentials": { "type": "string", "minLength": 2 },
                "registration": { "type": "string" }
              }
            },
            "approvedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "appliesToVersion": { "type": "integer", "minimum": 1 },
            "scope": { "type": "string", "minLength": 10 },
            "reviewDue": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg"],
      "properties": {
        "bg": { "type": "string", "minLength": 2 },
        "en": { "type": "string", "minLength": 2 }
      }
    },
    "excludedBy": {
      "description": "Identifier of the screening protocol whose exclusion criteria gate this one. Task 6.4.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$"
    },
    "breathing": {
      "description": "Required when kind is breathing. Durations are seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "cycle", "repeat", "exit"],
      "properties": {
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration"],
          "properties": {
            "duration": { "type": "number", "minimum": 0, "maximum": 5 }
          }
        },
        "cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phases"],
          "properties": {
            "phases": {
              "description": "Fixed order: inhale, holdIn, exhale, holdOut. Optional phases may be omitted.",
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "duration"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["inhale", "holdIn", "exhale", "holdOut"]
                  },
                  "duration": { "type": "number", "minimum": 0.5, "maximum": 30 },
                  "hapticIntensity": {
                    "description": "rising, falling or steady. The value itself is clinical.",
                    "type": "string",
                    "enum": ["rising", "falling", "steady"]
                  }
                }
              }
            }
          }
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cycles"],
          "properties": {
            "cycles": { "type": "integer", "minimum": 1, "maximum": 60 },
            "firstCycleFactor": { "type": "number", "minimum": 1, "maximum": 2 }
          }
        },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration"],
          "properties": {
            "duration": { "type": "number", "minimum": 1, "maximum": 15 }
          }
        },
        "userTempo": {
          "description": "Range the person may slow down or speed up within. Omit to forbid it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number", "minimum": 0.75, "maximum": 1 },
            "max": { "type": "number", "minimum": 1, "maximum": 1.25 }
          }
        }
      }
    },
    "steps": {
      "description": "Required when kind is grounding. Wording is clinical content; the engine only counts and displays.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bg"],
            "properties": {
              "bg": { "type": "string", "minLength": 2 },
              "en": { "type": "string", "minLength": 2 }
            }
          },
          "minDuration": { "type": "number", "minimum": 0, "maximum": 120 }
        }
      }
    },
    "notes": {
      "description": "Free text for the reviewer. Never shown to the person using the app.",
      "type": "string"
    }
  }
}
