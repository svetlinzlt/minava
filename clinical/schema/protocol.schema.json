{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minava.bg/schema/protocol-1.json",
  "title": "Minava clinical protocol",
  "description": "Structure of a clinical protocol file. Mechanical bounds only: this schema constrains what the engine can execute, never what is clinically correct. See docs/ДИШАНЕ.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "status",
    "approval",
    "title"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version of this schema the file was written against.",
      "type": "integer",
      "const": 1
    },
    "id": {
      "description": "Stable identifier. Never reused for different content.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$"
    },
    "version": {
      "description": "Incremented on every content change. Approval applies to one version only.",
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "breathing",
        "grounding",
        "regulation",
        "exposure",
        "screening",
        "crisis-path"
      ]
    },
    "status": {
      "description": "draft and review never ship. Only approved is executable in a release build.",
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved"
      ]
    },
    "approval": {
      "description": "Null until a qualified professional has signed off in writing on this exact version.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvedBy",
            "approvedAt",
            "appliesToVersion",
            "scope"
          ],
          "properties": {
            "approvedBy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "credentials"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 2
                },
                "credentials": {
                  "type": "string",
                  "minLength": 2
                },
                "registration": {
                  "type": "string"
                }
              }
            },
            "approvedAt": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "appliesToVersion": {
              "type": "integer",
              "minimum": 1
            },
            "scope": {
              "type": "string",
              "minLength": 10
            },
            "reviewDue": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg"
      ],
      "properties": {
        "bg": {
          "type": "string",
          "minLength": 2
        },
        "en": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "excludedBy": {
      "description": "Identifier of the screening protocol whose exclusion criteria gate this one. Task 6.4.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$"
    },
    "breathing": {
      "description": "Required when kind is breathing. Durations are seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "cycle",
        "repeat",
        "exit"
      ],
      "properties": {
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration"
          ],
          "properties": {
            "duration": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phases"
          ],
          "properties": {
            "phases": {
              "description": "Fixed order: inhale, holdIn, exhale, holdOut. Optional phases may be omitted.",
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "duration"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "inhale",
                      "holdIn",
                      "exhale",
                      "holdOut"
                    ]
                  },
                  "duration": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 30
                  },
                  "hapticIntensity": {
                    "description": "rising, falling or steady. The value itself is clinical.",
                    "type": "string",
                    "enum": [
                      "rising",
                      "falling",
                      "steady"
                    ]
                  },
                  "depth": {
                    "description": "How full the breath is, not how long it lasts. Separate from duration on purpose: the literature suggests that instructing someone to breathe slowly often makes them breathe deeper, which lowers CO2 — thought to be one of the mechanisms that sustains panic. Which value is right is a clinical decision (task 6.1); the engine only carries it.",
                    "type": "string",
                    "enum": [
                      "shallow",
                      "normal",
                      "deep"
                    ]
                  }
                }
              }
            }
          }
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycles"
          ],
          "properties": {
            "cycles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "firstCycleFactor": {
              "type": "number",
              "minimum": 1,
              "maximum": 2
            }
          }
        },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration"
          ],
          "properties": {
            "duration": {
              "type": "number",
              "minimum": 1,
              "maximum": 15
            }
          }
        },
        "userTempo": {
          "description": "Range the person may slow down or speed up within. Omit to forbid it.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0.75,
              "maximum": 1
            },
            "max": {
              "type": "number",
              "minimum": 1,
              "maximum": 1.25
            }
          }
        }
      }
    },
    "section": {
      "description": "Which group of the catalogue this practice belongs to. The list passed fifteen practices and a flat list stops working: a person does not read thirty lines to choose one. Required for grounding, regulation and exposure.",
      "type": "string",
      "enum": [
        "nervous-system",
        "mindset",
        "worry",
        "attention",
        "action",
        "challenge"
      ]
    },
    "estimatedMinutes": {
      "description": "Roughly how long the practice takes, shown next to its name. The difference between trying and skipping is often knowing it is three minutes and not twenty.",
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "stopRule": {
      "description": "What to do if the practice makes things worse, shown with the practice itself. REQUIRED for section attention: a systematic review puts adverse events in meditation at roughly 8% overall, and the single most common one reported is anxiety itself. An app that hands meditation to an anxious person and says nothing about that is careless.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bg"
      ],
      "properties": {
        "bg": {
          "type": "string",
          "minLength": 2
        },
        "en": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "preparation": {
      "description": "Shown once before the rounds begin, and never repeated. Getting into position is not part of the exercise: a practice with nine rounds must not tell someone nine times where to put their hands.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bg"
            ],
            "properties": {
              "bg": {
                "type": "string",
                "minLength": 2
              },
              "en": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "minDuration": {
            "type": "number",
            "minimum": 0,
            "maximum": 120
          }
        }
      }
    },
    "steps": {
      "description": "Required when kind is grounding. Wording is clinical content; the engine only counts and displays.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bg"
            ],
            "properties": {
              "bg": {
                "type": "string",
                "minLength": 2
              },
              "en": {
                "type": "string",
                "minLength": 2
              }
            }
          },
          "minDuration": {
            "type": "number",
            "minimum": 0,
            "maximum": 120
          }
        }
      }
    },
    "notes": {
      "description": "Free text for the reviewer. Never shown to the person using the app.",
      "type": "string"
    },
    "measure": {
      "description": "What the person is asked to rate before and after. Present only when the protocol is meant to be run as a before/after loop — the way docs/ТРЕНИРАНЕ.md describes training, rather than as a one-off exercise.",
      "type": "string",
      "enum": [
        "activation-0-10"
      ]
    },
    "rounds": {
      "description": "How many times the whole sequence of steps repeats. Distinct from breathing.repeat.cycles: a round is one pass through `steps`, not one breath.",
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "sides": {
      "description": "Sides the exercise is performed on, in order. Omit for exercises that have no sides.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "right",
          "left"
        ]
      }
    },
    "recoveryProtocol": {
      "description": "Identifier of the regulation protocol that must follow this one. REQUIRED for kind exposure: two independent sources warn that challenging without a way back into regulation accumulates tension, and can worsen symptoms where the nervous system is already dysregulated. The rule is a property of the schema so that nobody has to remember it.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$"
    }
  }
}
